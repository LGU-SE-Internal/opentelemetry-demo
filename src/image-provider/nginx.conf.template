load_module modules/ngx_otel_module.so;

pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    otel_exporter {
        endpoint ${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT_GRPC};
    }
    otel_trace on;
    otel_trace_context propagate;
    otel_service_name ${OTEL_SERVICE_NAME};
    otel_span_name image-provider;

    # Map to get real client IP from X-Forwarded-For or remote_addr
    map $http_x_forwarded_for $real_client_ip {
        default $remote_addr;
        ~^(?P<first_ip>[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) $first_ip;
    }

    # Structured JSON log format for TLS events
    log_format json_log '{'
        '"client_ip": "$real_client_ip",'
        '"tls_version": "$ssl_protocol",'
        '"cipher_suite": "$ssl_cipher",'
        '"client_cert_fingerprint": "$ssl_client_fingerprint",'
        '"request": "$request",'
        '"status": $status,'
        '"error_reason": "$ssl_error"'
    '}';

    access_log /dev/stdout json_log;
    error_log /dev/stderr warn;

# Rate limit zone configuration
limit_req_zone $real_client_ip zone=image_rate_limit:10m rate=${NGINX_RATE_LIMIT_RPS:-10}r/s;
# Per-image rate limit zone: limit by request URI (image path)
limit_req_zone $request_uri zone=per_image:10m rate=${NGINX_PER_IMAGE_RATE_LIMIT_RPS:-2}r/s;

# Custom 429 error page handler
error_page 429 @rate_limit_exceeded;

    include mime.types;
    sendfile on;
    server {
        listen 8080;
        listen [::]:8080;

        resolver 127.0.0.11;
        autoindex off;

        server_name _;
        server_tokens off;

        root /static;
        gzip_static on;

        location /status {
            stub_status on;
            access_log  on;           
            allow all;
        }

        location /healthz {
            access_log off;
            allow all;
            default_type text/plain;
            return 200 '';
        }

        location /health {
            access_log off;
            allow all;
            default_type text/plain;
            return 200 'OK';
        }

        location /ready {
            access_log off;
            allow all;
            default_type text/plain;
            if (!-d /static) {
                return 503 'NOT_READY';
            }
            if (!-r /static) {
                return 503 'NOT_READY';
            }
            return 200 'READY';
        }

        # Rate limit image assets only
        location ~* \.(png|jpg|jpeg|gif|webp|svg)$ {
            limit_req zone=image_rate_limit burst=5 nodelay;
            limit_req zone=per_image burst=5 nodelay;
            try_files $uri =404;
        }

        # Serve all other static assets without rate limit
        location / {
            try_files $uri =404;
        }

        # Rate limit exceeded response
        location @rate_limit_exceeded {
            add_header Retry-After 1 always;
            default_type text/plain;
            return 429 "Too Many Requests - Please try again later";
        }
    }

    ${TLS_ENABLED:+${TLS_ENABLED,,} == "true" ? '
    server {
        listen 8443 ssl;
        listen [::]:8443 ssl;

        resolver 127.0.0.11;
        autoindex off;

        server_name _;
        server_tokens off;

        root /static;
        gzip_static on;

        ssl_certificate ${TLS_CERT_PATH};
        ssl_certificate_key ${TLS_KEY_PATH};
        ssl_protocols ${TLS_MIN_VERSION:-TLSv1.2} ${TLS_MIN_VERSION:-TLSv1.2} == "TLSv1.2" ? "TLSv1.3" : "";
        ssl_ciphers ${TLS_CIPHER_SUITES:-ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384};
        ssl_prefer_server_ciphers on;

        ${MTLS_ENABLED:+${MTLS_ENABLED,,} == "true" ? '
        ssl_client_certificate ${MTLS_CA_CERT_PATH};
        ssl_verify_client on;
        ' : ''}

        error_page 495 496 497 =400 /400_bad_request;
        location /400_bad_request {
            default_type text/plain;
            return 400 "Bad Request: HTTP request sent to HTTPS port";
        }

        location /status {
            stub_status on;
            access_log  on;           
            allow all;
        }

        location /healthz {
            access_log off;
            allow all;
            default_type text/plain;
            return 200 '';
        }

        location /health {
            access_log off;
            allow all;
            default_type text/plain;
            return 200 'OK';
        }

        location /ready {
            access_log off;
            allow all;
            default_type text/plain;
            if (!-d /static) {
                return 503 'NOT_READY';
            }
            if (!-r /static) {
                return 503 'NOT_READY';
            }
            return 200 'READY';
        }

        # Rate limit image assets only
        location ~* \.(png|jpg|jpeg|gif|webp|svg)$ {
            limit_req zone=image_rate_limit burst=5 nodelay;
            limit_req zone=per_image burst=5 nodelay;
            try_files $uri =404;
        }

        # Serve all other static assets without rate limit
        location / {
            try_files $uri =404;
        }

        # Rate limit exceeded response
        location @rate_limit_exceeded {
            add_header Retry-After 1 always;
            default_type text/plain;
            return 429 "Too Many Requests - Please try again later";
        }
    }
    ' : ''}
}
