load_module modules/ngx_otel_module.so;

pid /tmp/nginx.pid;

# Graceful shutdown configuration
worker_shutdown_timeout ${NGINX_GRACEFUL_SHUTDOWN_TIMEOUT:-30}s;
error_log /var/log/nginx/error.log notice;

events {
    worker_connections 1024;
}

http {
    otel_exporter {
        endpoint ${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT_GRPC};
    }
    otel_trace on;
    otel_trace_context propagate;
    otel_service_name ${OTEL_SERVICE_NAME};
    otel_span_name image-provider;

    # Map to get real client IP from X-Forwarded-For or remote_addr
    map $http_x_forwarded_for $real_client_ip {
        default $remote_addr;
        ~^(?P<first_ip>[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) $first_ip;
    }

    # Rate limit zone configuration
    limit_req_zone $real_client_ip zone=image_rate_limit:10m rate=${NGINX_RATE_LIMIT_RPS:-10}r/s;

    # Custom 429 error page handler
    error_page 429 @rate_limit_exceeded;

    include mime.types;
    sendfile on;
    server {
        listen ${IMAGE_PROVIDER_PORT};
        listen [::]:${IMAGE_PROVIDER_PORT};

        resolver 127.0.0.11;
        autoindex off;

        server_name _;
        server_tokens off;

        root /static;
        gzip_static on;

        location /status {
            stub_status on;
            access_log  on;           
            allow all;
        }

        location /healthz {
            access_log off;
            allow all;
            default_type text/plain;
            return 200 '';
        }

        location /health {
            access_log off;
            allow all;
            default_type text/plain;
            return 200 'OK';
        }

        location /ready {
            access_log off;
            allow all;
            default_type text/plain;
            if (!-d /static) {
                return 503 'NOT_READY';
            }
            if (!-r /static) {
                return 503 'NOT_READY';
            }
            return 200 'READY';
        }

        # Rate limit image assets only
        location ~* \.(png|jpg|jpeg|gif|webp|svg)$ {
            limit_req zone=image_rate_limit burst=5 nodelay;
            try_files $uri =404;
        }

        # Serve all other static assets without rate limit
        location / {
            try_files $uri =404;
        }

        # Rate limit exceeded response
        location @rate_limit_exceeded {
            add_header Retry-After 1 always;
            default_type text/plain;
            return 429 "Too Many Requests - Please try again later";
        }
    }

    ${IMAGE_PROVIDER_TLS_CERT_PATH:+
    server {
        listen 443 ssl;
        listen [::]:443 ssl;

        resolver 127.0.0.11;
        autoindex off;

        server_name _;
        server_tokens off;

        root /static;
        gzip_static on;

        ssl_certificate ${IMAGE_PROVIDER_TLS_CERT_PATH};
        ssl_certificate_key ${IMAGE_PROVIDER_TLS_KEY_PATH};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        ${IMAGE_PROVIDER_TLS_CA_CERT_PATH:+
        ssl_client_certificate ${IMAGE_PROVIDER_TLS_CA_CERT_PATH};
        ssl_verify_client on;
        }

        location /status {
            stub_status on;
            access_log  on;           
            allow all;
        }

        location /healthz {
            access_log off;
            allow all;
            default_type text/plain;
            return 200 '';
        }

        location /health {
            access_log off;
            allow all;
            default_type text/plain;
            return 200 'OK';
        }

        location /ready {
            access_log off;
            allow all;
            default_type text/plain;
            if (!-d /static) {
                return 503 'NOT_READY';
            }
            if (!-r /static) {
                return 503 'NOT_READY';
            }
            return 200 'READY';
        }

        # Rate limit image assets only
        location ~* \.(png|jpg|jpeg|gif|webp|svg)$ {
            limit_req zone=image_rate_limit burst=5 nodelay;
            try_files $uri =404;
        }

        # Serve all other static assets without rate limit
        location / {
            try_files $uri =404;
        }

        # Rate limit exceeded response
        location @rate_limit_exceeded {
            add_header Retry-After 1 always;
            default_type text/plain;
            return 429 "Too Many Requests - Please try again later";
        }
    }
    }
}
