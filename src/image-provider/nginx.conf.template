load_module modules/ngx_otel_module.so;

pid /tmp/nginx.pid;

worker_shutdown_timeout 30s;

events {
    worker_connections 1024;
}

http {
    # Map to detect shutdown state
    map $shutdown_time $in_shutdown {
        default 0;
        ~.+ 1;
    }

    # Health response bodies
    map $in_shutdown $health_status {
        0 '{"status": "healthy"}';
        1 '{"status": "shutting_down"}';
    }

    map $in_shutdown $health_code {
        0 200;
        1 503;
    }

    # Custom error page for 503 during shutdown
    error_page 503 /503_shutdown.html;
    location = /503_shutdown.html {
        root /usr/share/nginx/html;
        internal;
    }

    otel_exporter {
        endpoint ${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT_GRPC};
    }
    otel_trace on;
    otel_trace_context propagate;
    otel_service_name ${OTEL_SERVICE_NAME};
    otel_span_name image-provider;

    # Map to get real client IP from X-Forwarded-For or remote_addr
    map $http_x_forwarded_for $real_client_ip {
        default $remote_addr;
        ~^(?P<first_ip>[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) $first_ip;
    }

    # Structured JSON log format for TLS events
    log_format json_log '{'
        '"client_ip": "$real_client_ip",'
        '"tls_version": "$ssl_protocol",'
        '"cipher_suite": "$ssl_cipher",'
        '"client_cert_fingerprint": "$ssl_client_fingerprint",'
        '"request": "$request",'
        '"status": $status,'
        '"error_reason": "$ssl_error"'
    '}';

    access_log /dev/stdout json_log;
    error_log /dev/stderr warn;

# Rate limit zone configuration
limit_req_zone $real_client_ip zone=image_rate_limit:10m rate=${NGINX_RATE_LIMIT_RPS:-10}r/s;
# Per-image rate limit zone: limit by request URI (image path)
limit_req_zone $request_uri zone=per_image:10m rate=${NGINX_PER_IMAGE_RATE_LIMIT_RPS:-2}r/s;

# Custom 429 error page handler
error_page 429 @rate_limit_exceeded;

    include mime.types;
    sendfile on;

    # Upstream image storage backend
    upstream image_storage {
        server ${IMAGE_UPSTREAM_HOST}:${IMAGE_UPSTREAM_PORT};
        retry_backoff exponential base=100ms factor=2;
    }

    # Proxy configuration
    proxy_connect_timeout 2s;
    proxy_send_timeout 2s;
    proxy_read_timeout 2s;
    proxy_next_upstream error timeout http_500 http_502 http_503 http_504 http_404 http_429;
    proxy_next_upstream_tries 3;
    proxy_next_upstream_timeout 1s;

    $ENABLE_TLS == "false" ? '
    server {
        listen 8080;
        listen [::]:8080;

        resolver 127.0.0.11;
        autoindex off;

        server_name _;
        server_tokens off;

        # Reject new requests with 503 during shutdown
        if ($in_shutdown) {
            return 503;
        }

        root /static;
        gzip_static on;

        location /health {
            access_log off;
            allow all;
            default_type application/json;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            expires 0;
            return $health_code $health_status;
        }

        location /healthz {
            access_log off;
            allow all;
            default_type text/plain;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            expires 0;
            return 200 '';
        }

        location /ready {
            access_log off;
            allow all;
            default_type text/plain;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            expires 0;
            if (!-d /static) {
                return 503 'NOT_READY';
            }
            if (!-r /static) {
                return 503 'NOT_READY';
            }
            return 200 'READY';
        }

        # Nginx status endpoint with retry metrics
        location /nginx_status {
            stub_status on;
            access_log off;
            allow all;
            
            # Custom retry metrics
            set $retry_total 0;
            set $retry_failed_total 0;
            set $retry_success_rate 0;
            
            if ($upstream_retry_count > 0) {
                set $retry_total $upstream_retry_count;
            }
            
            if ($upstream_status ~ ^5[0-9][0-9]$) {
                set $retry_failed_total 1;
            }
            
            add_header nginx_upstream_retry_total $retry_total always;
            add_header nginx_upstream_retry_failed_total $retry_failed_total always;
            add_header nginx_upstream_retry_success_rate $retry_success_rate always;
        }

        # Rate limit image assets only
        location ~* \.(png|jpg|jpeg|gif|webp|svg)$ {
            limit_req zone=image_rate_limit burst=5 nodelay;
            limit_req zone=per_image burst=5 nodelay;
            expires 1y;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            
            # Only retry GET/HEAD requests
            if ($request_method !~ ^(GET|HEAD)$) {
                proxy_next_upstream off;
            }
            
            proxy_pass http://image_storage$request_uri;
        }

        # CSS/JS assets
        location ~* \.(css|js)$ {
            expires 1d;
            add_header Cache-Control "public, max-age=86400" always;
            try_files $uri =404;
        }

        # HTML assets
        location ~* \.(html)$ {
            expires 5m;
            add_header Cache-Control "public, max-age=300" always;
            try_files $uri =404;
        }

        # Serve all other static assets without rate limit
        location / {
            try_files $uri =404;
        }

        # Rate limit exceeded response
        location @rate_limit_exceeded {
            add_header Retry-After 1 always;
            default_type text/plain;
            return 429 "Too Many Requests - Please try again later";
        }
    }
    ' : '
    server {
        listen 8080 ssl;
        listen [::]:8080 ssl;

        resolver 127.0.0.11;
        autoindex off;

        server_name _;
        server_tokens off;

