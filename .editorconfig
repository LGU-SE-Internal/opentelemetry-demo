root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.sh]
indent_size = 2
end_of_line = lf

[*.{yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Dockerfile]
indent_size = 2

[*.{js,ts,jsx,tsx}]
indent_size = 2

[*.go]
indent_size = 4
indent_style = tab

[*.proto]
indent_size = 2

[*.{css,scss,less}]
indent_size = 2

[*.json]
indent_size = 2

[*.toml]
indent_size = 2
