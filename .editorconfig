# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# General rules for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python: 4 space indentation
[*.py]
indent_size = 4

# Shell scripts
[*.{sh,bash}]
indent_size = 2
end_of_line = lf

# YAML
[*.{yaml,yml}]
indent_size = 2
indent_style = space

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Dockerfile
[Dockerfile]
indent_size = 2

# JavaScript/TypeScript
[*.{js,jsx,ts,tsx}]
indent_size = 2

# Go
[*.go]
indent_style = tab
indent_size = 4

# Protocol buffers
[*.proto]
indent_size = 2

# C# files
[*.cs]
indent_size = 4

# Java files
[*.java]
indent_size = 4

# Rust files
[*.rs]
indent_size = 4

# C/C++ files
[*.{c,cpp,h}]
indent_size = 4
