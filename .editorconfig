# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python files
[*.py]
indent_size = 4

# Shell scripts
[*.sh]
indent_size = 2

# YAML files
[*.{yaml,yml}]
indent_size = 2

# Markdown files (trailing whitespace is intentional for line breaks)
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Dockerfile
[Dockerfile]
indent_size = 2

# JavaScript/TypeScript files
[*.{js,ts,jsx,tsx}]
indent_size = 2

# Go files (standard gofmt uses tabs)
[*.go]
indent_style = tab
indent_size = 4

# Protocol buffer files
[*.proto]
indent_size = 2
