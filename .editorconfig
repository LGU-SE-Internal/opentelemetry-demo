# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Python files
[*.py]
indent_size = 4

# Shell scripts
[*.sh]
indent_size = 2
shell_variant = bash

# YAML files
[*.{yaml,yml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Dockerfile
[Dockerfile]
indent_size = 2

# JavaScript/TypeScript
[*.{js,ts,jsx,tsx}]
indent_size = 2

# Go files
[*.go]
indent_style = tab
indent_size = 4

# Protobuf files
[*.proto]
indent_size = 2

# HTML/CSS
[*.{html,css}]
indent_size = 2
